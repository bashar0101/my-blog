# Formspree endpoint for the contact form.
# Create a form at https://formspree.io and paste its endpoint here.
VITE_FORMSPREE_ENDPOINT=

# GitHub repository the deployed admin commits to. Defaults match this repo.
VITE_GITHUB_OWNER=bashar0101
VITE_GITHUB_REPO=my-blog
VITE_GITHUB_BRANCH=main

# GitHub OAuth protects /admin in deployed environments. Set these in Vercel,
# not in source control. AUTH_SESSION_SECRET must be a random value of 32+ bytes.
AUTH_BASE_URL=https://your-domain.example
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
AUTH_SESSION_SECRET=
ADMIN_GITHUB_LOGIN=bashar0101
